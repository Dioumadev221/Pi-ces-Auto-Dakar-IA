    {
      "id": "dd334e05-29e4-4560-b70e-24ff0c178f6b",
      "name": "agent_compatibilite",
      "type": "@n8n/n8n-nodes-langchain.agentTool",
      "typeVersion": 3,
      "position": [
        380,
        260
      ],
      "parameters": {
        "toolDescription": "Trouve les pieces compatibles avec un vehicule (marque, modele, annee) et donne leur reference et leur designation.",
        "text": "={{ $fromAI('demande', 'La demande du client a traiter, avec toutes les informations utiles', 'string') }}",
        "options": {
          "systemMessage": "Tu recois une demande contenant une marque, un modele, une annee et\nparfois un type de piece. Cherche les references compatibles avec\nchercher_compatibilite, puis leur designation avec lire_designation.\nSi un type de piece est demande, ne garde que les pieces de ce type.\nReponds par une liste : reference, designation.\nSi rien ne correspond, reponds exactement : AUCUNE PIECE COMPATIBLE.\nSi la marque, le modele ou l'annee manque, reponds : INFORMATION MANQUANTE\nsuivi de ce qui manque.",
          "maxIterations": 5
        }
      }
    },
    {
      "id": "7b3e868b-ec67-481d-af55-687ccb688ce5",
      "name": "agent_stock_prix",
      "type": "@n8n/n8n-nodes-langchain.agentTool",
      "typeVersion": 3,
      "position": [
        800,
        260
      ],
      "parameters": {
        "toolDescription": "Donne le prix en FCFA et la quantite en stock d'une ou plusieurs references de pieces.",
        "text": "={{ $fromAI('demande', 'La demande du client a traiter, avec toutes les informations utiles', 'string') }}",
        "options": {
          "systemMessage": "Tu recois une ou plusieurs references de pieces. Pour chacune, lis le prix\navec lire_piece et la quantite avec lire_stock.\nReponds par une liste : reference, designation, prix en FCFA, quantite.\nSi une reference n'existe pas, dis-le. N'invente aucun chiffre.",
          "maxIterations": 5
        }
      }
    },
    {
      "id": "c88d52df-ab53-46e4-85ac-375385b199b2",
      "name": "agent_commandes",
      "type": "@n8n/n8n-nodes-langchain.agentTool",
      "typeVersion": 3,
      "position": [
        1200,
        260
      ],
      "parameters": {
        "toolDescription": "Donne l'etat d'une commande a partir de son numero (format CMD-0000) et enregistre les nouvelles commandes.",
        "text": "={{ $fromAI('demande', 'La demande du client a traiter, avec toutes les informations utiles', 'string') }}",
        "options": {
          "systemMessage": "Tu traites les commandes de Pieces Auto Dakar IA.\nPour un suivi, lis la commande avec lire_commande et donne son statut,\nsa ville et sa date. Si le numero n'existe pas, reponds : COMMANDE\nINTROUVABLE.\nN'invente jamais un statut.",
          "maxIterations": 5
        }
      }
    },
    {
