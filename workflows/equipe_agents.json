    {
      "id": "5379061c-a192-47d4-bbad-60e17e3f083a",
      "name": "chercher_compatibilite",
      "type": "n8n-nodes-base.dataTableTool",
      "typeVersion": 1.1,
      "position": [
        460,
        500
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Retourne les references de pieces compatibles avec un vehicule pour une annee donnee. Parametres : marque (avec majuscule initiale : Toyota, Hyundai, Peugeot, Renault), modele (Corolla, Hilux, Accent, 206, Clio) et annee (nombre, ex. 2012). Ne retourne rien si aucune piece ne convient.",
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": "TYzFROXxaism4zCS",
          "cachedResultName": "compatibilites"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "marque",
              "condition": "eq",
              "keyValue": "={{ $fromAI('marque', 'Marque du vehicule, majuscule initiale, ex. Toyota', 'string') }}"
            },
            {
              "keyName": "modele",
              "condition": "eq",
              "keyValue": "={{ $fromAI('modele', 'Modele du vehicule, ex. Corolla ou 206', 'string') }}"
            },
            {
              "keyName": "annee_debut",
              "condition": "lte",
              "keyValue": "={{ $fromAI('annee', 'Annee du vehicule, ex. 2012', 'number') }}"
            },
            {
              "keyName": "annee_fin",
              "condition": "gte",
              "keyValue": "={{ $fromAI('annee', 'Annee du vehicule, ex. 2012', 'number') }}"
            }
          ]
        },
        "returnAll": true
      }
    },
    {
      "id": "9c22bff8-93e7-48a9-bcd0-14364f406f2e",
